$TTL    86400
@       IN      SOA     siodhcp.sio.lan. admin.sio.lan. (
                2025112102      ; Serial
                3600            ; Refresh
                1800            ; Retry
                604800          ; Expire
                86400 )         ; Minimum TTL

        IN      NS      siodhcp.sio.lan.

; Registros estáticos
siodhcp IN      A       192.168.10.2
